// Prisma schema for article-recommendation-ui.
// Recommendations are generated on demand via the upstream workflow; the
// RecommendationRun model below records generation requests so the schema
// defines at least one model for the live database. Additive changes only:
// never edit or drop existing columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecommendationRun {
  id        String   @id @default(cuid())
  emailId   String?
  keyword   String
  client    String
  createdAt DateTime @default(now())
}
