generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Additive model: records recommendation runs. Added to satisfy Prisma's
// requirement of at least one model; safe additive-only change (prisma db push
// simply creates this new table).
model RecommendationRun {
  id        String   @id @default(cuid())
  emailId   String
  keyword   String
  client    String   @default("")
  createdAt DateTime @default(now())
}
