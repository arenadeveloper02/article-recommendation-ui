generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecommendationRun {
  id        String   @id @default(cuid())
  emailId   String
  keyword   String
  client    String   @default("")
  output    String
  createdAt DateTime @default(now())
}
