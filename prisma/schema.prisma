// Prisma schema — Neon Postgres on Vercel. The app primarily reads/writes
// through external Arena workflows; the RecommendationRun model below exists
// so the schema defines at least one model and provides an additive place to
// persist generation history if/when server-side persistence is wired up.
// Never edit or remove existing fields — add new models/columns only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RecommendationRun {
  id        String   @id @default(cuid())
  email     String
  keyword   String
  client    String
  output    String
  createdAt DateTime @default(now())
}
