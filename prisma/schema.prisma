generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Additive model (the live baseline has no models yet). Records recommendation
// generation requests for basic usage visibility. Safe for `prisma db push`
// against the existing database: it only ADDS a new table.
model RecommendationRequest {
  id        String   @id @default(cuid())
  keyword   String
  client    String
  emailId   String?
  createdAt DateTime @default(now())
}
