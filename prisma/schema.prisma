generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Recommendation runs recorded per Arena email. Additive model only — the
// deployed baseline defined no models, so this is a pure addition.
model RecommendationRun {
  id        String   @id @default(cuid())
  emailId   String
  keyword   String
  client    String
  output    String?
  createdAt DateTime @default(now())

  @@index([emailId])
}
